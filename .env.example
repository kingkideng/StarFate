# DASHSCOPE_API_KEY: 阿里云百炼 API Key, used only by the server-side API proxy.
DASHSCOPE_API_KEY="sk-xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx"

# DASHSCOPE_MODEL_NAME: 阿里云百炼的模型名称。速度优先推荐 qwen3.6-flash-2026-04-16。
DASHSCOPE_MODEL_NAME="qwen3.6-flash-2026-04-16"

# AMAP_API_KEY: 高德开放平台 Web 服务 API Key，用于出生地地理编码。
AMAP_API_KEY="xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx"
